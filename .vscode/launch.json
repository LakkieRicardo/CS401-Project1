    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Server through game.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/game.py",
            "console": "integratedTerminal",
            "args": ["server", "45783"]
        },
        {
            "name": "Launch Client through game.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/game.py",
            "console": "integratedTerminal",
            "args": ["connect", "localhost:45783"]
        }
    ]
}